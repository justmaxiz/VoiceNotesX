NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Run scripts/configure-local-data.ps1 to append generated local PostgreSQL
# credentials, DATABASE_URL, MIGRATION_DATABASE_URL, and AUDIO_STORAGE_PATH.
# PostgreSQL listens on 127.0.0.1:5433. JWT_SECRET is also generated by the script.
AI_PROVIDER=gemini
# GEMINI_API_KEY= synthetic development environment only
# GEMINI_MODEL=gemini-3.5-flash-lite
# Production requires AI_PROVIDER=alice, YANDEX_API_KEY and YANDEX_FOLDER_ID.
# Override native media binaries when using system installations:
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# Summary budgets. Scheduler/worker run with the API; no browser timer required.
SUMMARY_MAX_DAYS=366
SUMMARY_MAX_NOTES=60
SUMMARY_MAX_CHARS=48000
SUMMARY_FIELD_CHARS=1200
SUMMARY_MAX_PER_HOUR=6
SUMMARY_CONCURRENCY=2
